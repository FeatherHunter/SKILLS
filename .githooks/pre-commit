#!/bin/bash
# .githooks/pre-commit
# SKILLS/ 多 skill 仓库: 自动检测改动, 跑对应 skill 的测试
# 失败 → exit 1 阻断 commit

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v python3 >/dev/null 2>&1; then
    echo "⚠️  python3 未找到, 跳过 hook"
    exit 0
fi

# 暂存区 + 工作区改动的文件
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
if [ -z "$CHANGED" ]; then
    CHANGED=$(git diff --name-only --diff-filter=ACMR 2>/dev/null)
fi
if [ -z "$CHANGED" ]; then
    exit 0
fi

# 检测涉及哪些 skill (有 tests/ 目录的)
declare -A NEED_TEST
for path in $CHANGED; do
    case "$path" in
        居家管家/*)
            NEED_TEST[居家管家]=1
            ;;
        卡路里/*)
            NEED_TEST[卡路里]=1
            ;;
        备忘录/*)
            NEED_TEST[备忘录]=1
            ;;
        私家大厨/*)
            NEED_TEST[私家大厨]=1
            ;;
        图眼/*)
            NEED_TEST[图眼]=1
            ;;
    esac
done

# 无测试相关 skill 改动
if [ ${#NEED_TEST[@]} -eq 0 ]; then
    exit 0
fi

# L4 测试隔离层(#402 · #386 Q6 双保险):
# 强制 SKILLS_DB_PATH → mktemp,即使各 skill conftest 无 autouse 也能保证
# 钩子内任何 pytest 都写临时库,生产 DB 永不被触碰(根 AGENTS.md DB 隔离红线)。
# 背景: 用户 shell 持久 SKILLS_DB_PATH=D:\\2Study\\StudyNotes\\.db(生产),
#        若钩子不注入,未自行隔离的测试会直写生产(08-09~14 事故根因)。
# opt-out: 无(钩子场景 = 强制隔离;调试请勿在提交时进行)。
HOOK_TEMP_DIR_MSYS="$(mktemp -d)"
# git-bash 的 mktemp 返回 MSYS 路径(/tmp/tmp.xxx);Windows python 会把它解析成
# 当前盘根的 \tmp(如 D:\tmp)——隔离虽生效但路径不一致,且 trap 清理不到实际写入点。
# 用 cygpath -w 转 Windows 原生路径(两种运行时一致;cygpath 在 git-bash 必有)。
if command -v cygpath >/dev/null 2>&1; then
    HOOK_TEMP_DIR="$(cygpath -w "$HOOK_TEMP_DIR_MSYS")"
else
    HOOK_TEMP_DIR="$HOOK_TEMP_DIR_MSYS"
fi
export SKILLS_DB_PATH="$HOOK_TEMP_DIR"
echo "🔒 [pre-commit] L4 隔离已注入: SKILLS_DB_PATH=$HOOK_TEMP_DIR"
cleanup_hook_temp() {
    rm -rf "$HOOK_TEMP_DIR_MSYS" 2>/dev/null || true
}
trap cleanup_hook_temp EXIT

FAILED=0
for skill in "${!NEED_TEST[@]}"; do
    if [ ! -d "$skill/tests" ]; then
        continue
    fi

    # 总纲 04 §原则 4(本 skill 改造版):HELP 镜像自动同步
    # 如果 diff 含 references/scenarios.yaml / templates/help_center.html
    # → 自动跑 scripts/build_manual.py, 把更新后的 {技能名}.html 一起入 commit
    if [ "$skill" = "居家管家" ] && echo "$CHANGED" | grep -qE '居家管家/(references/scenarios\.yaml|templates/help_center\.html)'; then
        echo ""
        echo "🔄 [pre-commit] 检测到 HELP 源变更,自动跑 build_manual.py 同步 居家管家.html..."
        if ! (cd "$skill" && python3 scripts/build_manual.py 2>&1); then
            echo ""
            echo "❌ [居家管家] build_manual.py 失败, commit 已拒绝"
            FAILED=1
            continue
        fi
        # 把同步后的 HTML 加入本次 commit
        git add "$skill/居家管家.html"
        echo "✓ [居家管家] HELP HTML 已同步并加入 commit"
    fi

    echo ""
    echo "🧪 [pre-commit] 跑 $skill pytest..."
    # PYTHONUTF8=1: Windows GBK 环境下强制 UTF-8, 避免 subprocess 读 UTF-8 stdout 时
    # 'gbk' codec 解码失败误报 (test_help.py 调 memo_cli.py help 的子进程 stdout)
    if ! (cd "$skill" && PYTHONUTF8=1 python3 -m pytest tests/ --tb=short -q 2>&1); then
        echo ""
        echo "❌ [$skill] 测试失败, commit 已拒绝"
        echo "   禁止用 --no-verify 绕过 (见各 skill 的 SKILL.md 硬规则)"
        FAILED=1
    else
        echo "✓ [$skill] 测试通过"
    fi

    # 还原 pytest 副产物: 某些 skill 的测试会调 help 命令覆写 skill 根 HTML
    # (如 备忘录/test_help.py 调 memo_cli.py help → render_help 覆写 备忘录.html)
    # 这是测试运行时的临时写文件, 不应进入本次 commit; 还原到 HEAD 版本
    if [ "$skill" = "备忘录" ]; then
        git checkout HEAD -- "备忘录/备忘录.html" 2>/dev/null || true
    fi
done

if [ $FAILED -ne 0 ]; then
    exit 1
fi
exit 0
