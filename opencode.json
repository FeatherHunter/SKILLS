{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "zen-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zen Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:ZEN_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
